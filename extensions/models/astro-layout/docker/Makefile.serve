# Usage (run from anywhere; SERVE_DIR resolves against your shell's working directory):
#   make -f extensions/models/astro-layout/docker/Makefile.serve \
#        SERVE_DIR=/abs/path/to/cloned-site      # required, relative or absolute
#   PORT=8081 make    ...same above              # optional override (default 4321)
#   make stop                                  # kill the running container

HERE := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
SERVE_DIR ?= $(error SERVE_DIR is required, e.g. SERVE_DIR=./cloned-site)
PORT      ?= 4321
PREFIX    = astro-layout-serve
CONTAINER = $(PREFIX)-container
DOCKERFILE = Dockerfile.serve

# Absolute path, resolved via a POSIX helper so relative AND absolute dirs work uniformly.
SERVE_ABS := $(shell sh "$(HERE)/resolve-serve-dir.sh" '$(SERVE_DIR)')

.PHONY: all run rebuild stop

all: run

run: ## Build and serve at http://localhost:<PORT>/ -> container 4321
	@docker rm -f $(CONTAINER) 2>/dev/null || true
	docker build \
	  -t $(PREFIX):latest \
	  -f "$(HERE)/$(DOCKERFILE)" "$(SERVE_ABS)"
	@echo "Serving '$(SERVE_DIR)' -> http://localhost:$(PORT)/   ($(SERVE_ABS))"
	docker run --rm --name $(CONTAINER) \
	  -p $(PORT):4321 \
	  $(PREFIX):latest

rebuild: ## Alias for run (always builds from scratch)
	$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) run SERVE_DIR=$(SERVE_DIR) PORT=$(PORT)

stop: ## Stop the running serve container (image remains cached for reuse)
	@docker rm -f $(CONTAINER) 2>/dev/null || true
