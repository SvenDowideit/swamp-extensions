# Usage (run from anywhere; SERVE_DIR resolves against your shell's working directory):
#   make -f extensions/models/astro-layout/docker/Makefile.serve \
#        SERVE_DIR=/abs/path/to/cloned-site      # required, relative or absolute
#   PORT=8081 make    ...same above              # optional override (default 4321)
#   make stop                                  # kill the most recent run by tag prefix

HERE := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
SERVE_DIR ?= $(error SERVE_DIR is required, e.g. SERVE_DIR=./cloned-site)
PORT      ?= 4321
PREFIX    = astro-layout-serve
DOCKERFILE = Dockerfile.serve

# Absolute path, resolved via a POSIX helper so relative AND absolute dirs work uniformly.
SERVE_ABS := $(shell sh "$(HERE)/resolve-serve-dir.sh" '$(SERVE_DIR)')

.PHONY: all run rebuild stop _need-md5sum

_need-md5sum:
	@command -v md5sum >/dev/null 2>&1 || { echo 'ERROR: this makefile requires coreutils (md5sum).' >&2; exit 1; }

all: run

run: _need-md5sum ## Build the image for SERVE_DIR and serve at http://localhost:<PORT>/ -> container 4321
	docker build -t $(PREFIX):$(shell printf '%s' '$(SERVE_ABS)' | md5sum | cut -c1-7) \
	  -f "$(HERE)/$(DOCKERFILE)" "$(SERVE_ABS)"
	@echo "Serving '$(SERVE_DIR)' -> http://localhost:$(PORT)/   ($(SERVE_ABS))"
	-docker run --rm \
	  -p $(PORT):4321 \
	  $(PREFIX):$(shell printf '%s' '$(SERVE_ABS)' | md5sum | cut -c1-7)

rebuild: _need-md5sum ## Clear cached layers for SERVE_DIR then (re)serve at http://localhost:<PORT>/ -> 4321
	-docker rmi -f "$(PREFIX):$(shell printf '%s' '$(SERVE_ABS)' | md5sum | cut -c1-7)" 2>/dev/null || true
	$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) run SERVE_DIR=$(SERVE_DIR) PORT=$(PORT)

stop: ## Stop any running serve container tagged with PREFIX (images remain cached for reuse)
	@docker ps --filter "ancestor=$(PREFIX)" --format '{{.ID}}' | xargs -r docker stop 2>/dev/null || true